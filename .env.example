# XofN — templat env. Salin ke `.env.local` lalu isi. File ini TIDAK boleh berisi nilai rahasia.
# Nama variabel mengikuti ARCHITECTURE.md §12. Tidak pernah ada private key di file env:
# transaksi publik ditandatangani lewat keystore Foundry (--account) atau --ledger.
#
# Siapa yang membaca file ini:
# - Next.js memuat `.env.local` otomatis (bagian APLIKASI).
# - Foundry TIDAK memuat `.env.local`. Untuk forge/cast muat dulu ke shell:
#     set -a; source .env.local; set +a
#   Catatan: setelah itu `forge test` ikut menjalankan tes fork yang RPC-nya terisi.

# ─────────────────────────────── APLIKASI (Next.js) ───────────────────────────────

# local | testnet | mainnet. `local` = mode simulation terhadap Anvil (deployments/local.json).
# Jaringan tanpa manifest yang sah berjalan di mode preview.
NEXT_PUBLIC_XOFN_NETWORK=
# URL absolut situs, mis. http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Opsional. Kosong → AppKit tidak dibuat.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Opsional. Kosong → RPC publik dari registry chain (src/lib/chains).
NEXT_PUBLIC_RPC_ROBINHOOD=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_ARBITRUM=

# ─────────────────────────────── SERVER (rahasia, jangan di-commit) ───────────────

# Opsional. RPC khusus XofN Check; kosong → RPC publik registry chain.
CHECK_RPC_ROBINHOOD=
CHECK_RPC_BASE=
CHECK_RPC_ARBITRUM=
# Cache Supabase: isi KEDUANYA atau kosongkan keduanya (kosong → cache memori).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Kosong → semua route /api/cron/* menjawab 503.
CRON_SECRET=

# ─────────────────────────────── FOUNDRY: tes fork READ-ONLY ──────────────────────

# Kosong → tes fork chain itu dilewati.
FORK_RPC_ROBINHOOD=
FORK_RPC_BASE=
FORK_RPC_ARBITRUM=
FORK_RPC_ROBINHOOD_TESTNET=
FORK_RPC_BASE_SEPOLIA=
FORK_RPC_ARBITRUM_SEPOLIA=

# ─────────────────────────────── DEPLOY Fase 1a: Robinhood testnet (46630) ─────────
# Dibaca script/0*_*.s.sol. Hanya ALAMAT publik; key tetap di keystore.

RH_TESTNET_RPC=
# Alamat keystore deployer (EOA polos, tanpa delegasi EIP-7702).
DEPLOYER_ADDRESS=
# Safe 2-of-3 v1.4.1 KHUSUS testnet (owner Registry dan Graduator).
SAFE_ADDRESS=
# Penerima NFT posisi likuiditas (PRD P41). Testnet: alamat sementara.
LP_RECIPIENT=
# Harus SAMA di Fase 2 (bersama deployer yang sama), kalau tidak alamat token tidak seragam.
DEPLOY_SALT=

# ─────────────────────────────── DEPLOY lain: FROZEN (CLAUDE.md §5.1) ─────────────
# Belum dipakai. Fase 1b (mainnet) dan Fase 2 belum dibuka.

RH_MAINNET_RPC=
BASE_SEPOLIA_RPC=
ARB_SEPOLIA_RPC=
BASE_RPC=
ARB_RPC=
RH_BLOCKSCOUT_API=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
